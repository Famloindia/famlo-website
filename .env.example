# Famlo Web environment template
# Copy this file to .env.local for local development.
# Request real credentials through a secure channel. Do not store live secrets in Git.

# Public site and app URLs
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_BACKEND_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_BACKEND_IMAGE_UPLOAD_PATH=/api/upload
EXPO_PUBLIC_BACKEND_IMAGE_DELETE_PATH=/api/uploads/delete

# Supabase
SUPABASE_ENVIRONMENT=staging
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_value_here
SUPABASE_SERVICE_ROLE_KEY=your_value_here
SUPABASE_URL=https://example.supabase.co
SUPABASE_DB_URL=postgresql://user:password@example-host:5432/database
DATABASE_URL=postgresql://user:password@example-host:5432/database
POSTGRES_URL=postgresql://user:password@example-host:5432/database
CHAT_DB_URL=postgresql://user:password@example-host:5432/database
STAGING_DB_URL=postgresql://user:password@example-host:5432/database
PRODUCTION_DB_URL=postgresql://user:password@example-host:5432/database
STAGING_PROJECT_REF=your_value_here
PRODUCTION_PROJECT_REF=your_value_here

# Admin authentication and session security
ADMIN_PASSWORD=your_value_here
ADMIN_SESSION_SECRET=your_value_here
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=your_value_here
PAN_ENCRYPTION_KEY=your_value_here
CRON_SECRET=your_value_here
DEV_RESET_SECRET=your_value_here

# Email and notifications
EMAIL_PROVIDER=log
EMAIL_EXECUTION_ENABLED=false
EMAIL_FROM_ADDRESS=ops@example.com
EMAIL_REPLY_TO_ADDRESS=support@example.com
MAIL_FROM_EMAIL=Famlo <hello@example.com>
RESEND_API_KEY=your_value_here

# Razorpay and billing
RAZORPAY_KEY_ID=test_key_here
RAZORPAY_KEY_SECRET=your_value_here
RAZORPAY_WEBHOOK_SECRET=your_value_here
RAZORPAY_REFUNDS_ENABLED=false
RAZORPAYX_ENABLED=false
RAZORPAYX_KEY_ID=test_key_here
RAZORPAYX_KEY_SECRET=your_value_here
RAZORPAYX_ACCOUNT_NUMBER=your_value_here
RAZORPAYX_WEBHOOK_SECRET=your_value_here

# Channex and OTA
CHANNEX_ENVIRONMENT=staging
CHANNEX_ENV=staging
CHANNEX_STAGING_BASE_URL=https://staging.channex.io
CHANNEX_STAGING_API_KEY=your_value_here
CHANNEX_PRODUCTION_BASE_URL=https://app.channex.io
CHANNEX_PRODUCTION_API_KEY=your_value_here
CHANNEX_WEBHOOK_SECRET=your_value_here
CHANNEX_WEBHOOK_AUTH_MODE=signature
CHANNEX_AIRBNB_AUTHORIZE_URL=https://example.com/oauth/authorize
CHANNEX_SYNC_EXECUTION_ENABLED=false
FAMLO_CHANNEX_ALLOW_PRODUCTION_MUTATIONS=false

# Cloudflare R2 storage
R2_ACCOUNT_ID=your_value_here
R2_ACCESS_KEY_ID=your_value_here
R2_SECRET_ACCESS_KEY=your_value_here
R2_BUCKET_NAME=your_bucket_name_here
R2_PUBLIC_URL=https://cdn.example.com

# WhatsApp and OTP providers
FAMLO_ENABLE_WHATSAPP_NOTIFICATIONS=false
WHATSAPP_API_KEY=your_value_here
WHATSAPP_PHONE_NUMBER_ID=your_value_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_value_here
WHATSAPP_APP_SECRET=your_value_here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_value_here
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v22.0
WHATSAPP_VERIFICATION_CODE_TEMPLATE_NAME=famlo_whatsapp_verification_code
WHATSAPP_VERIFICATION_CODE_TEMPLATE_LANGUAGE=copy_exact_language_code_from_meta
WHATSAPP_SETUP_CONFIRMATION_TEMPLATE_NAME=famlo_whatsapp_setup_confirmed
WHATSAPP_SETUP_CONFIRMATION_TEMPLATE_LANGUAGE=en_US
WHATSAPP_HOST_APPROVAL_TEMPLATE_NAME=famlo_host_booking_approval
WHATSAPP_HOST_APPROVAL_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GUEST_BOOKING_PENDING_TEMPLATE_NAME=famlo_guest_booking_pending
WHATSAPP_GUEST_BOOKING_PENDING_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GUEST_BOOKING_CONFIRMED_TEMPLATE_NAME=famlo_guest_booking_confirmed
WHATSAPP_GUEST_BOOKING_CONFIRMED_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GUEST_BOOKING_DECLINED_TEMPLATE_NAME=famlo_guest_booking_declined
WHATSAPP_GUEST_BOOKING_DECLINED_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GUEST_REFUND_INITIATED_TEMPLATE_NAME=famlo_guest_refund_initiated
WHATSAPP_GUEST_REFUND_INITIATED_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GUEST_CHECKIN_REMINDER_TEMPLATE_NAME=famlo_guest_checkin_reminder
WHATSAPP_GUEST_CHECKIN_REMINDER_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GUEST_CHECKOUT_REMINDER_TEMPLATE_NAME=famlo_guest_checkout_reminder
WHATSAPP_GUEST_CHECKOUT_REMINDER_TEMPLATE_LANGUAGE=en_US
WHATSAPP_HOST_BOOKING_CANCELLED_TEMPLATE_NAME=famlo_host_booking_cancelled
WHATSAPP_HOST_BOOKING_CANCELLED_TEMPLATE_LANGUAGE=en_US
WHATSAPP_HOST_PAYOUT_SCHEDULED_TEMPLATE_NAME=famlo_host_payout_scheduled
WHATSAPP_HOST_PAYOUT_SCHEDULED_TEMPLATE_LANGUAGE=en_US
WHATSAPP_HOST_PAYOUT_PROCESSED_TEMPLATE_NAME=famlo_host_payout_processed
WHATSAPP_HOST_PAYOUT_PROCESSED_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GUEST_MESSAGE_RECEIVED_HOST_TEMPLATE_NAME=famlo_guest_message_received_host
WHATSAPP_GUEST_MESSAGE_RECEIVED_HOST_TEMPLATE_LANGUAGE=en_US
WHATSAPP_HOST_MESSAGE_RECEIVED_GUEST_TEMPLATE_NAME=famlo_host_message_received_guest
WHATSAPP_HOST_MESSAGE_RECEIVED_GUEST_TEMPLATE_LANGUAGE=en_US
WHATSAPP_PRO_GRACE_WARNING_HOST_TEMPLATE_NAME=famlo_pro_grace_warning_host
WHATSAPP_PRO_GRACE_WARNING_HOST_TEMPLATE_LANGUAGE=en_US
WHATSAPP_PRO_EXPIRED_SHIFTED_TO_FREE_HOST_TEMPLATE_NAME=famlo_pro_expired_shifted_to_free_host
WHATSAPP_PRO_EXPIRED_SHIFTED_TO_FREE_HOST_TEMPLATE_LANGUAGE=en_US
WHATSAPP_STAGING_TESTER_ALLOWLIST=your_verified_staging_tester_number
WHATSAPP_ALLOW_STAGING_DELIVERY=false
TWO_FACTOR_API_KEY=your_value_here

# Feature flags and finance controls
FAMLO_ENABLE_FAMLO_PLUS_PAGE=true
FAMLO_ENABLE_PRO_DASHBOARD=true
FAMLO_PRO_DEV_RESET_ENABLED=false
FAMLO_PRO_MANUAL_ACTIVATION_ENABLED=false
FAMLO_PRO_AUTOPAY_ENABLED=false
FAMLO_PRO_AUTOPAY_REQUIRE_SUBSCRIPTION=true
PRO_BILLING_PAYMENT_EXECUTION_ENABLED=false
REFUND_PROVIDER_EXECUTION_ENABLED=false
SETTLEMENT_PAYOUT_EXECUTION_ENABLED=false
AUTO_PAYOUT_ENABLED=false
AUTO_REFUND_ENABLED=false
ENABLE_ADMIN_DIAGNOSTICS=false
ENABLE_LEGACY_BOOKING_MIRROR=false
FINANCE_EVENT_DRY_RUN=true
FINANCE_EVENT_PIPELINE_ENABLED=false
FINANCE_SETTLEMENT_ENGINE_ENABLED=false
FINANCE_DIRECT_BOOKING_FOLIO_WRITES_ENABLED=false
OTA_FINANCE_ENGINE_ENABLED=false
OTA_FOLIO_LINE_WRITES_ENABLED=false
HOST_FINANCE_UI_ENABLED=true
HOST_FINANCE_STATEMENTS_V2_ENABLED=true
GST_COLLECTION_ENABLED=false
GST_EXPORT_ENABLED=false
GST_INVOICE_GENERATION_ENABLED=false
PLATFORM_FEE_INVOICE_GENERATION_ENABLED=false
INVOICE_PDF_GENERATION_ENABLED=false
INVOICE_EMAIL_DELIVERY_ENABLED=false
PAYOUT_ACCOUNT_CREATION_ENABLED=false
PAYOUT_ACCOUNT_VALIDATION_ENABLED=false
PAYOUT_ADMIN_APPROVAL_REQUIRED=true
PAYOUT_AUTO_RETRY_ENABLED=false
PAYOUT_HOLD_ENABLED=true
REFUND_ADMIN_APPROVAL_REQUIRED=true
SETTLEMENT_APPROVAL_FLOW_ENABLED=true
SETTLEMENT_DRAFT_GENERATION_ENABLED=false
SETTLEMENT_INCLUDE_OTA_ENABLED=true
SETTLEMENT_REQUIRE_CHECKOUT_COMPLETED=true
SETTLEMENT_DEBUG_API_ENABLED=false
HOST_SETTLEMENT_READ_ENABLED=true
TAX_SETTINGS_UI_ENABLED=true
TAX_COMPLIANCE_LOCK_ENABLED=true
TAX_COMPLIANCE_REQUIRES_ADMIN_CONFIRMATION=true
TAX_COPY_SAFETY_ENABLED=true
TAX_REPORTING_EXPORTS_ENABLED=false
TCS_ENABLED=false
TDS_ENABLED=false

# Business and invoice settings
FAMLO_LEGAL_ENTITY_NAME=Famlo Example Pvt Ltd
FAMLO_LEGAL_ADDRESS=Example address here
FAMLO_GSTIN=your_value_here
FAMLO_GST_STATE=your_value_here
FAMLO_CURRENT_ACCOUNT_NAME=your_value_here
FAMLO_CURRENT_ACCOUNT_NUMBER=your_value_here
FAMLO_CURRENT_ACCOUNT_IFSC=your_value_here
GST_INVOICE_NUMBER_PREFIX=GTI
CREDIT_NOTE_NUMBER_PREFIX=CN
FINANCE_DOCUMENT_STORAGE_DIR=./.generated/finance-documents
FINANCE_PG_FEE_BORNE_BY=host
FINANCE_PG_FEE_ENABLED=false
FINANCE_PG_FEE_FIXED_AMOUNT=0
FINANCE_PG_FEE_RATE_BPS=0
FINANCE_TCS_ENABLED=false
FINANCE_TCS_RATE_BPS=0
FINANCE_TDS_ENABLED=false
FINANCE_TDS_RATE_BPS=0
FAMLO_PRO_RAZORPAY_FEE_PCT=0
FAMLO_PRO_RAZORPAY_FEE_FIXED_INR=0
FAMLO_PRO_RAZORPAY_FEE_GST_PCT=18
FAMLO_PRO_USD_INR_RATE=0
AUTO_REFUND_MAX_AMOUNT=0
FAMLO_HOLD_TTL_MINUTES=15
FAMLO_HOST_BOOKING_ACTION_TTL_MINUTES=30

# Optional local admin tooling
CONFIRM_RESET_STAGING_SCHEMA=false
CONFIRM_RECOVER_EMPTY_STAGING=false
CONFIRM_REPAIR_STAGING_PUBLIC_GRANTS=false
CONFIRM_REPAIR_STAGING_RLS=false
RESET_BACKUP_DIR=./backups/staging-reset
SCHEMA_DRIFT_REPORT_PATH=./reports/schema-drift/report.json
