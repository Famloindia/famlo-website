APP_ENV=local
NEXT_PUBLIC_SUPABASE_URL=https://STAGING_SUPABASE_URL.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key
SUPABASE_ENVIRONMENT=staging
FAMLO_TEMP_ALLOW_LOCAL_PRODUCTION_SUPABASE=false

ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me

# Email configuration (Disabled/Log-only locally)
EMAIL_PROVIDER=log
EMAIL_EXECUTION_ENABLED=false
EMAIL_FROM_ADDRESS=ops@example.local
EMAIL_REPLY_TO_ADDRESS=support@example.local
RESEND_API_KEY=
MAIL_FROM_EMAIL=hello@example.local

# Razorpay / RazorpayX (Test keys only)
RAZORPAY_KEY_ID=rzp_test_example
RAZORPAY_KEY_SECRET=test-secret
RAZORPAY_WEBHOOK_SECRET=test-webhook-secret
RAZORPAYX_ENABLED=false
RAZORPAYX_KEY_ID=rzp_test_example
RAZORPAYX_KEY_SECRET=test-secret
RAZORPAYX_ACCOUNT_NUMBER=1000000000
RAZORPAYX_WEBHOOK_SECRET=test-webhook-secret

# Payout/Refund/Billing features (Disabled locally)
PRO_BILLING_PAYMENT_EXECUTION_ENABLED=false
REFUND_PROVIDER_EXECUTION_ENABLED=false
SETTLEMENT_PAYOUT_EXECUTION_ENABLED=false
AUTO_PAYOUT_ENABLED=false
CHANNEX_SYNC_EXECUTION_ENABLED=false

# Channex (Staging/Sandbox only)
CHANNEX_ENVIRONMENT=staging
CHANNEX_STAGING_BASE_URL=https://staging.channex.io
CHANNEX_STAGING_API_KEY=staging-api-key
CHANNEX_PRODUCTION_BASE_URL=
CHANNEX_PRODUCTION_API_KEY=

# Cloudflare R2 - Local/Staging Bucket Configuration (Must use 'famlo-images-staging')
R2_ACCOUNT_ID=local-r2-account-id
R2_ACCESS_KEY_ID=local-r2-access-key-id
R2_SECRET_ACCESS_KEY=local-r2-secret-access-key
R2_BUCKET_NAME=famlo-images-staging
R2_PUBLIC_URL=http://localhost:3000/r2

# WhatsApp (Disabled/Mocked locally)
FAMLO_ENABLE_WHATSAPP_NOTIFICATIONS=false
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_HOST_APPROVAL_TEMPLATE_LANGUAGE=en

# Other keys / features
TWO_FACTOR_API_KEY=
CRON_SECRET=
FAMLO_ENABLE_FAMLO_PLUS_PAGE=true
FAMLO_ENABLE_PRO_DASHBOARD=true
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=
CHANNEX_WEBHOOK_SECRET=
CHANNEX_WEBHOOK_AUTH_MODE=signature
EXPO_PUBLIC_BACKEND_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_BACKEND_IMAGE_UPLOAD_PATH=/api/upload
EXPO_PUBLIC_BACKEND_IMAGE_DELETE_PATH=/api/uploads/delete
