+      grace_until: null,
+      reason: "pro_billing_cancelled",
+    };
+  }
+
+  if (entitlementStatus === "expired" || subscriptionStatus === "expired" || (periodMillis !== null && now.getTime() > periodMillis)) {
+    return {
+      allowed: false,
+      status: "expired",
+      current_period_end: currentPeriodEnd,
+      grace_until: null,
+      reason: "pro_billing_period_ended",
+    };
+  }
+
+  return DEFAULT_RESULT;
+}
+
+function mergeAccessResults(legacy: HostProAccessResult, proBilling: HostProAccessResult): HostProAccessResult {
+  if (proBilling.allowed && !legacy.allowed) return proBilling;
+  if (legacy.allowed && !proBilling.allowed) return legacy;
+  if (proBilling.allowed && legacy.allowed) {
+    const proBoundary = toMillis(proBilling.current_period_end) ?? 0;
+    const legacyBoundary = toMillis(legacy.current_period_end) ?? 0;
+    return proBoundary >= legacyBoundary ? proBilling : legacy;
+  }
+  if (legacy.reason === DEFAULT_RESULT.reason && proBilling.reason !== DEFAULT_RESULT.reason) {
+    return proBilling;
+  }
+  return legacy;
+}
