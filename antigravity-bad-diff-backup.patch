+      status: "active",
+      current_period_end: currentPeriodEnd,
+      grace_until: null,
+      reason: "pro_billing_entitlement_active",
+    };
+  }
+
+  if (
+    entitlementStatus === "draft" ||
+    entitlementStatus === "pending_payment" ||
+    subscriptionStatus === "draft" ||
+    subscriptionStatus === "pending_payment" ||
+    subscriptionStatus === "past_due"
+  ) {
+    return {
+      allowed: false,
+      status: "inactive",
+      current_period_end: currentPeriodEnd,
+      grace_until: null,
+      reason: "pro_billing_payment_pending",
+    };
+  }
+
+  if (entitlementStatus === "cancelled" || subscriptionStatus === "cancelled") {
