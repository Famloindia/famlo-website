+  const subscriptionStatus = String(subscription?.status ?? "").trim().toLowerCase();
+  const currentPeriodEnd = asString(row.current_period_end) ?? asString(subscription?.current_period_end);
+  const periodMillis = toMillis(currentPeriodEnd);
+  const activeWindowOpen = periodMillis !== null && now.getTime() <= periodMillis;
