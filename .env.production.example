APP_ENV=production
NEXT_PUBLIC_SUPABASE_URL=https://production-example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=production-anon-key
SUPABASE_SERVICE_ROLE_KEY=production-service-role-key
SUPABASE_ENVIRONMENT=production

ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me

# Email configuration (Production uses Resend for real emails)
EMAIL_PROVIDER=resend
EMAIL_EXECUTION_ENABLED=false
EMAIL_FROM_ADDRESS=ops@example.com
EMAIL_REPLY_TO_ADDRESS=support@example.com
RESEND_API_KEY=production-resend-key
MAIL_FROM_EMAIL=hello@example.com

# Razorpay / RazorpayX (Production uses live keys ONLY)
RAZORPAY_KEY_ID=rzp_live_example
RAZORPAY_KEY_SECRET=live-secret
RAZORPAY_WEBHOOK_SECRET=live-webhook-secret
RAZORPAYX_ENABLED=true
RAZORPAYX_KEY_ID=rzp_live_example
RAZORPAYX_KEY_SECRET=live-secret
RAZORPAYX_ACCOUNT_NUMBER=production-account-number
RAZORPAYX_WEBHOOK_SECRET=live-webhook-secret

# Payout/Refund/Billing features (Enabled in Production)
PRO_BILLING_PAYMENT_EXECUTION_ENABLED=false
REFUND_PROVIDER_EXECUTION_ENABLED=false
SETTLEMENT_PAYOUT_EXECUTION_ENABLED=false
AUTO_PAYOUT_ENABLED=false
CHANNEX_SYNC_EXECUTION_ENABLED=false

# Channex (Production environment)
CHANNEX_ENV=production
CHANNEX_STAGING_BASE_URL=
CHANNEX_STAGING_API_KEY=
CHANNEX_PRODUCTION_BASE_URL=https://app.channex.io
CHANNEX_PRODUCTION_API_KEY=production-api-key

# Cloudflare R2 - Production Bucket Configuration (Must use 'famlo-images')
R2_ACCOUNT_ID=production-r2-account-id
R2_ACCESS_KEY_ID=production-r2-access-key-id
R2_SECRET_ACCESS_KEY=production-r2-secret-access-key
R2_BUCKET_NAME=famlo-images
R2_PUBLIC_URL=https://pub-production.r2.dev

# WhatsApp (Disabled by default in Production)
FAMLO_ENABLE_WHATSAPP_NOTIFICATIONS=false
WHATSAPP_API_KEY=production-whatsapp-key
WHATSAPP_PHONE_NUMBER_ID=production-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=production-verify-token
WHATSAPP_HOST_APPROVAL_TEMPLATE_LANGUAGE=en

# Other keys / features
TWO_FACTOR_API_KEY=production-two-factor-key
CRON_SECRET=production-cron-secret
FAMLO_ENABLE_FAMLO_PLUS_PAGE=true
FAMLO_ENABLE_PRO_DASHBOARD=true
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=production-encryption-key
CHANNEX_WEBHOOK_SECRET=production-webhook-secret
CHANNEX_WEBHOOK_AUTH_MODE=signature
EXPO_PUBLIC_BACKEND_API_BASE_URL=https://famlo.in
EXPO_PUBLIC_BACKEND_IMAGE_UPLOAD_PATH=/api/upload
EXPO_PUBLIC_BACKEND_IMAGE_DELETE_PATH=/api/uploads/delete
