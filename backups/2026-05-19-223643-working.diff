+    ackStatus: "not_acknowledged",
+    linkedBookingId: "booking-1",
+    externalBookingId: "ext-booking-1",
+    externalRoomTypeId: "room-1",
+    arrivalDate: "2026-05-22",
+    departureDate: "2026-05-20",
